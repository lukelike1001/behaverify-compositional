module main {
  type act_t = enum { up, down, stay };
  function ctrl(x : real, y : real) : act_t;
  var px : real;
  var py : real;
  var mode : act_t;

  axiom c0 : (forall (x : real, y : real) :: ((x >= 10.0) && (x <= 13.0)) ==> (ctrl(x, y) != up));
  axiom c1 : (forall (x : real, y : real) :: ((x >= 13.0) && (x <= 16.0)) ==> (ctrl(x, y) != up));
  axiom c2 : (forall (x : real, y : real) :: ((x >= 16.0) && (x <= 19.0)) ==> (ctrl(x, y) != up));
  axiom c3 : (forall (x : real, y : real) :: ((x >= 19.0) && (x <= 22.0)) ==> (ctrl(x, y) != up));
  axiom c4 : (forall (x : real, y : real) :: ((x >= 22.0) && (x <= 25.0)) ==> (ctrl(x, y) != up));
  axiom c5 : (forall (x : real, y : real) :: ((x >= 25.0) && (x <= 28.0)) ==> (ctrl(x, y) != up));
  axiom c6 : (forall (x : real, y : real) :: ((x >= 28.0) && (x <= 31.0)) ==> (ctrl(x, y) != up));
  axiom c7 : (forall (x : real, y : real) :: ((x >= 31.0) && (x <= 34.0)) ==> (ctrl(x, y) != up));
  axiom c8 : (forall (x : real, y : real) :: ((x >= 34.0) && (x <= 37.0)) ==> (ctrl(x, y) != up));
  axiom c9 : (forall (x : real, y : real) :: ((x >= 37.0) && (x <= 40.0)) ==> (ctrl(x, y) != up));
  axiom c10 : (forall (x : real, y : real) :: ((x >= 40.0) && (x <= 43.0)) ==> (ctrl(x, y) != up));
  axiom c11 : (forall (x : real, y : real) :: ((x >= 43.0) && (x <= 46.0)) ==> (ctrl(x, y) != up));
  axiom c12 : (forall (x : real, y : real) :: ((x >= 46.0) && (x <= 49.0)) ==> (ctrl(x, y) != up));
  axiom c13 : (forall (x : real, y : real) :: ((x >= 49.0) && (x <= 52.0)) ==> (ctrl(x, y) != up));
  axiom c14 : (forall (x : real, y : real) :: ((x >= 52.0) && (x <= 55.0)) ==> (ctrl(x, y) != up));
  axiom c15 : (forall (x : real, y : real) :: ((x >= 55.0) && (x <= 58.0)) ==> (ctrl(x, y) != up));
  axiom c16 : (forall (x : real, y : real) :: ((x >= 58.0) && (x <= 61.0)) ==> (ctrl(x, y) != up));
  axiom c17 : (forall (x : real, y : real) :: ((x >= 61.0) && (x <= 64.0)) ==> (ctrl(x, y) != up));
  axiom c18 : (forall (x : real, y : real) :: ((x >= 64.0) && (x <= 67.0)) ==> (ctrl(x, y) != up));
  axiom c19 : (forall (x : real, y : real) :: ((x >= 67.0) && (x <= 70.0)) ==> (ctrl(x, y) != up));
  axiom c20 : (forall (x : real, y : real) :: ((x >= 70.0) && (x <= 73.0)) ==> (ctrl(x, y) != up));
  axiom c21 : (forall (x : real, y : real) :: ((x >= 73.0) && (x <= 76.0)) ==> (ctrl(x, y) != up));
  axiom c22 : (forall (x : real, y : real) :: ((x >= 76.0) && (x <= 79.0)) ==> (ctrl(x, y) != up));
  axiom c23 : (forall (x : real, y : real) :: ((x >= 79.0) && (x <= 82.0)) ==> (ctrl(x, y) != up));
  axiom c24 : (forall (x : real, y : real) :: ((x >= 82.0) && (x <= 85.0)) ==> (ctrl(x, y) != up));
  axiom c25 : (forall (x : real, y : real) :: ((x >= 85.0) && (x <= 88.0)) ==> (ctrl(x, y) != up));
  axiom c26 : (forall (x : real, y : real) :: ((x >= 88.0) && (x <= 91.0)) ==> (ctrl(x, y) != up));
  axiom c27 : (forall (x : real, y : real) :: ((x >= 91.0) && (x <= 94.0)) ==> (ctrl(x, y) != up));
  axiom c28 : (forall (x : real, y : real) :: ((x >= 94.0) && (x <= 97.0)) ==> (ctrl(x, y) != up));
  axiom c29 : (forall (x : real, y : real) :: ((x >= 97.0) && (x <= 100.0)) ==> (ctrl(x, y) != up));
  axiom c30 : (forall (x : real, y : real) :: ((x >= 100.0) && (x <= 103.0)) ==> (ctrl(x, y) != up));
  axiom c31 : (forall (x : real, y : real) :: ((x >= 103.0) && (x <= 106.0)) ==> (ctrl(x, y) != up));
  axiom c32 : (forall (x : real, y : real) :: ((x >= 106.0) && (x <= 109.0)) ==> (ctrl(x, y) != up));
  axiom c33 : (forall (x : real, y : real) :: ((x >= 109.0) && (x <= 112.0)) ==> (ctrl(x, y) != up));
  axiom c34 : (forall (x : real, y : real) :: ((x >= 112.0) && (x <= 115.0)) ==> (ctrl(x, y) != up));
  axiom c35 : (forall (x : real, y : real) :: ((x >= 115.0) && (x <= 118.0)) ==> (ctrl(x, y) != up));
  axiom c36 : (forall (x : real, y : real) :: ((x >= 118.0) && (x <= 121.0)) ==> (ctrl(x, y) != up));
  axiom c37 : (forall (x : real, y : real) :: ((x >= 121.0) && (x <= 124.0)) ==> (ctrl(x, y) != up));
  axiom c38 : (forall (x : real, y : real) :: ((x >= 124.0) && (x <= 127.0)) ==> (ctrl(x, y) != up));
  axiom c39 : (forall (x : real, y : real) :: ((x >= 127.0) && (x <= 130.0)) ==> (ctrl(x, y) != up));
  axiom c40 : (forall (x : real, y : real) :: ((x >= 130.0) && (x <= 133.0)) ==> (ctrl(x, y) != up));
  axiom c41 : (forall (x : real, y : real) :: ((x >= 133.0) && (x <= 136.0)) ==> (ctrl(x, y) != up));
  axiom c42 : (forall (x : real, y : real) :: ((x >= 136.0) && (x <= 139.0)) ==> (ctrl(x, y) != up));
  axiom c43 : (forall (x : real, y : real) :: ((x >= 139.0) && (x <= 142.0)) ==> (ctrl(x, y) != up));
  axiom c44 : (forall (x : real, y : real) :: ((x >= 142.0) && (x <= 145.0)) ==> (ctrl(x, y) != up));
  axiom c45 : (forall (x : real, y : real) :: ((x >= 145.0) && (x <= 148.0)) ==> (ctrl(x, y) != up));
  axiom c46 : (forall (x : real, y : real) :: ((x >= 148.0) && (x <= 151.0)) ==> (ctrl(x, y) != up));
  axiom c47 : (forall (x : real, y : real) :: ((x >= 151.0) && (x <= 154.0)) ==> (ctrl(x, y) != up));
  axiom c48 : (forall (x : real, y : real) :: ((x >= 154.0) && (x <= 157.0)) ==> (ctrl(x, y) != up));
  axiom c49 : (forall (x : real, y : real) :: ((x >= 157.0) && (x <= 160.0)) ==> (ctrl(x, y) != up));

  init { px = 0.0; py = 0.0; mode = stay; }
  next {
    mode' = ctrl(px, py);
    px' = if (mode' == up) then px + 1.0 else if (mode' == down) then px - 1.0 else px;
    py' = py;
  }

  invariant safe : ((px >= 10.0) && (px <= 160.0)) ==> (ctrl(px, py) != up);

  control { induction; check; print_results; }
}

  axiom c997 : (forall (x : real, y : real) :: ((x >= 3001.0) && (x <= 3004.0)) ==> (ctrl(x, y) != up));
  axiom c998 : (forall (x : real, y : real) :: ((x >= 3004.0) && (x <= 3007.0)) ==> (ctrl(x, y) != up));
  axiom c999 : (forall (x : real, y : real) :: ((x >= 3007.0) && (x <= 3010.0)) ==> (ctrl(x, y) != up));

  init { px = 0.0; py = 0.0; mode = stay; }
  next {
    mode' = ctrl(px, py);
    px' = if (mode' == up) then px + 1.0 else if (mode' == down) then px - 1.0 else px;
    py' = py;
  }

  invariant safe : ((px >= 10.0) && (px <= 3010.0)) ==> (ctrl(px, py) != up);

  control { induction; check; print_results; }
}

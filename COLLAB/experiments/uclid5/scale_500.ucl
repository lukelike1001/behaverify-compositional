  axiom c499 : (forall (x : real, y : real) :: ((x >= 1507.0) && (x <= 1510.0)) ==> (ctrl(x, y) != up));

  init { px = 0.0; py = 0.0; mode = stay; }
  next {
    mode' = ctrl(px, py);
    px' = if (mode' == up) then px + 1.0 else if (mode' == down) then px - 1.0 else px;
    py' = py;
  }

  invariant safe : ((px >= 10.0) && (px <= 1510.0)) ==> (ctrl(px, py) != up);

  control { induction; check; print_results; }
}

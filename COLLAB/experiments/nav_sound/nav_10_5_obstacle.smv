MODULE main
VAR
  x : real;
  y : real;
  v : real;
  th : real;
  u1 : real;
  u2 : real;
  dx : real;
  dy : real;
  k : 0..30;
INIT x >= 2.9 & x <= 3.1 & y >= 2.9 & y <= 3.1 & v = 0.0 & th = 0.0 & k = 0;
TRANS next(k) = (k < 30 ? k + 1 : 30);

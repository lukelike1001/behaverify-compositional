  init {
    assume (x >= 2.9 && x <= 3.1);
    assume (y >= 2.9 && y <= 3.1);
    v = 0.0;
    th = 0.0;
    k = 0;
  }

  next {
    if (k < 30) {
      x' = x + dx(v, th);
      y' = y + dy(v, th);
      v' = v + 0.2 * u1(x, y, v, th);
      th' = th + 0.2 * u2(x, y, v, th);
      k' = k + 1;
    } else {
      x' = x;
      y' = y;
      v' = v;
      th' = th;
      k' = k;
    }
  }

  invariant safe : !(x >= 1.0 && x <= 2.0 && y >= 1.0 && y <= 2.0);

  control {
    v_bmc = bmc(30);
    check;
    print_results;
  }

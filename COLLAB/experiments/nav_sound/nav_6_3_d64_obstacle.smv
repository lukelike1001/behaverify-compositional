MODULE main
VAR
  x : real;
  y : real;
  v : real;
  th : real;
  u1 : real;
  u2 : real;
  dx : real;
  dy : real;
  k : 0..30;
INIT x >= 2.9 & x <= 3.1 & y >= 2.9 & y <= 3.1 & v = 0.0 & th = 0.0 & k = 0;
TRANS next(k) = (k < 30 ? k + 1 : 30);
TRANS (k < 30) -> (next(x) = x + dx & next(y) = y + dy & next(v) = v + 0.2 * u1 & next(th) = th + 0.2 * u2);
TRANS (k >= 30) -> (next(x) = x & next(y) = y & next(v) = v & next(th) = th);

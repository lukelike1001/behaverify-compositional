configuration {
    neural
}
enumerations {'left', 'right'}
constants {lo := 0, hi := 4}
variables {
    variable { env a VAR REAL assign{result{0.0}}}
    variable { env b VAR REAL assign{result{0.0}}}
    variable { bl net NEURAL classification {'left', 'right'}
        inputs { a, b }
        config { real }
        source { './net_class.onnx' }
    }
    variable { bl seen VAR BOOLEAN assign{result{False}}}
}
environment_update {}
checks {}
environment_checks {}
actions {
    action { Look
        arguments {} local_variables {} read_variables {net} write_variables {seen}
        initial_values {}
        update {
            variable_statement { seen assign{case{(eq, net, 'left')}result{True}result{False}} }
            return_statement {result{success}}
        }
    }
    action { Idle
        arguments {} local_variables {} read_variables {} write_variables {seen}
        initial_values {}
        update {
            variable_statement { seen assign{result{seen}} }
            return_statement {result{success}}
        }
    }
}
sub_trees {}
tree {
    composite { Root sequence children { Look {} Idle {} }}
}
tick_prerequisite { True }
specifications {
    INVARSPEC { (implies, (and, (gt, a, 10.0), (lt, b, -10.0)), (eq, net, 'left')) }
}
